{
  "manifest_version": 3,
  "name": "BSG",
  "version": "1.0.1",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "tabs",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://*.leetcode.com/*",
    "https://api.binarysearchgang.com/*",
    "http://localhost/*",
    "http://localhost:*/*"
  ],
  "action": {
    "default_popup": "defaultPopup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; connect-src 'self' ws://localhost:8080 ws://localhost:5001 wss://api.binarysearchgang.com https://api.binarysearchgang.com http://localhost http://localhost:* ws://localhost:* wss://localhost:*; object-src 'self';"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "next/*",
        "login-page.html",
        "injected.js"
      ],
      "matches": [
        "*://leetcode.com/*",
        "*://*.leetcode.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "*://leetcode.com/problems/*",
        "*://*.leetcode.com/problems/*"
      ],
      "js": [
        "contentScript.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
