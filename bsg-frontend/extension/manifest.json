{
  "manifest_version": 3,
  "name": "Binary Search Gang",
  "version": "1.0.1",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "tabs",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://*.leetcode.com/*",
    "https://*.googleapis.com/*",
    "https://accounts.google.com/*",
    "https://api.binarysearchgang.com/*",
    "http://localhost:3000/*"
  ],
  "action": {
    "default_popup": "defaultPopup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; script-src-elem 'self' https://apis.google.com https://accounts.google.com https://www.gstatic.com; connect-src 'self' http://localhost:3000 wss://api.binarysearchgang.com https://*.googleapis.com https://*.firebaseapp.com https://accounts.google.com https://api.binarysearchgang.com; object-src 'self';"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "defaultPopup.html",
        "next/*",
        "login-page.html",
        "injected.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "*://leetcode.com/problems/*",
        "*://*.leetcode.com/problems/*"
      ],
      "js": [
        "contentScript.js"
      ],
      "run_at": "document_idle"
    }
  ]
}